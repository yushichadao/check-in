# ==================================================================
# 环境变量示例（本文件全部可省略）
# 本系统所有配置都有「内置默认值」（见 server/config.js 的 DEFAULTS），
# 不写 .env 也能直接上传运行；仅当需要覆盖某项时才复制本文件为 .env。
# .env 不会被提交到仓库。
# ==================================================================

# ---------------------- 运行 ----------------------
# 服务监听端口
PORT=3000

# production / development
NODE_ENV=production

# 反向代理跳数（部署在 Nginx 后保持 1；直接暴露设 0）
TRUST_PROXY=1

# 是否仅通过 HTTPS 传输 Cookie（启用 HTTPS 后设为 true；纯 http 访问须为 false）
COOKIE_SECURE=false

# 部署子路径（如 /check-in）；部署在域名根目录则留空
BASE_PATH=/check-in

# ---------------------- 安全密钥 ----------------------
# 令牌签名密钥：生产环境务必设置为足够长的随机字符串
# 生成： node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 留空时系统会在 data/.jwt-secret 自动生成并持久化
JWT_SECRET=

# 数据流加密 / 数据库导出包密钥（更改后旧的密文与导出包将无法解密）
# 生成： node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATAFLOW_KEY=

# 令牌有效期 / 权限工单超时自动驳回（小时）
TOKEN_TTL=2h
WO_TIMEOUT_HOURS=48

# ---------------------- 数据目录 ----------------------
# SQLite 数据库与密钥文件存放位置（可指向加密卷/受保护目录）
DB_DIR=./data

# ---------------------- 三层命名（勿混用） ----------------------
# ① 商品名（品牌）= 班级签到系统 —— 代码固定，任何端都不可改（邮件发件显示名也固定用它）。
# ② 班级名 —— 必填，**默认值就是空（未配置）**：留空则运维者无法登录（403）、
#    注册发码被拦截（503），须先在服务器终端执行 `npm run config` 配置。
#    示例（仅供参照，不要照抄）：通信工程2607班
GROUP_NAME=
# ③ 系统全称 —— 本班这套系统的完整称呼（浏览器标签标题、关于页「系统名称」、邮件正文应用名）。
#    留空 = 自动拼接「② 班级名 + ① 商品名」：班级名以「班 / 班级 / 年级 / 专业 / 学院 / 系」结尾时
#    只接「签到系统」（例：通信工程2607班 → 通信工程2607班签到系统），不会出现「X班班级签到系统」。
#    想用别的叫法（例：通信工程2607班考勤系统）就直接填这里。
SYSTEM_NAME=

# ---------------------- 初始运维者账号（仅首次建库时创建，之后修改无效） ----------------------
# 仅指定姓名；不再预置密码——运维者须在注册页完成邮箱验证并自行设置密码后才能登录。
# 忘记密码时可用 `npm run reset-ops` 在服务器终端重置（会同时标记为已验证）。
OPS_NAME=运维者

# ------------------------------------------------------------------
# 邮件（SMTP）：用于“忘记密码”的邮箱验证码自助重置
# 不配置（host/user/pass 任一为空）则该功能自动禁用，
# 仍可使用“请求管理员 / 开发者清除密码”的方式找回密码。
#
# 以 QQ 邮箱为例（SMTP_PASS 填“授权码”，不是 QQ 登录密码）：
#   SMTP_HOST=smtp.qq.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=你的QQ邮箱@qq.com
#   SMTP_PASS=邮箱授权码
# 163 邮箱：SMTP_HOST=smtp.163.com  SMTP_PORT=465  SMTP_SECURE=true
# 企业邮 / 其他：按服务商给的 SMTP 服务器填写；587 端口请设 SMTP_SECURE=false（STARTTLS）
# ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# 授权码：可填明文，也可填密文（enc:v1:…）。用 npm run config 配置时会自动加密写入。
# 加密密钥在 data/.secret-key，迁移服务器时务必一并复制，否则需重新填写。
SMTP_PASS=
# 发件人地址（必填，与 SMTP_USER 一致或不同均可）：
#   这是「专用发信邮箱」，与系统内任意登录账号邮箱互不相关——请勿填成运维者/管理者/用户的登录邮箱。
#   发件邮箱「在服务商处登记的账户名称 / 昵称」（QQ 邮箱「设置→账户」、163 / 企业邮账户资料）
#   决定了收件人看到的显示名，与本系统无关，需运维者自行到该邮箱服务商修改。
MAIL_FROM=
# 邮件主题与正文（可留空用默认；正文支持占位符：{code} 验证码、{minutes} 有效期分钟、{app} 应用名）
MAIL_SUBJECT=
MAIL_TEXT=
# 邮件正文中的应用名：留空则取「系统全称」（如 通信工程2607班签到系统）
MAIL_APP_NAME=
# 邮件落盘开关：设 1 时即使已配 SMTP 也只写文件（data/mail-outbox），不真正发信
MAIL_OUTBOX=

# ---------------------- 电子围栏判定 ----------------------
# 基础容差 / 容差上限 / 允许的最大定位误差（米）
FENCE_TOLERANCE_M=60
FENCE_MAX_TOLERANCE=120
FENCE_MAX_ACCURACY=200

# ---------------------- HTTPS（手机端定位等需安全上下文功能时启用） ----------------------
# 留空则纯 HTTP 运行（零配置默认）。配置证书与私钥路径（文件存在即自动启用 HTTPS 监听）。
# 请自行准备证书与私钥文件并填写下方路径；本系统不提供自签证书生成脚本。
# HTTPS_PORT=3443
# SSL_CERT=server/ssl/cert.pem
# SSL_KEY=server/ssl/key.pem
# SSL_CA=                              # 可选：证书链
# 仅允许 HTTPS（关闭 HTTP 监听）；同时会把登录 Cookie 标记为 Secure
# HTTPS_ONLY=false
# 保留 HTTP 监听，但把 HTTP 请求 301 跳转到 HTTPS（同样会把 Cookie 标记为 Secure）
# REDIRECT_HTTP_TO_HTTPS=false

